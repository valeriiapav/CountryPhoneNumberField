Name: absl_cord
Description: Abseil cord library
URL: https://abseil.io/
Version: head
Requires: absl_base = head, absl_config = head, absl_cord_internal = head, absl_cordz_functions = head, absl_cordz_info = head, absl_cordz_update_scope = head, absl_cordz_update_tracker = head, absl_core_headers = head, absl_crc32c = head, absl_crc_cord_state = head, absl_endian = head, absl_function_ref = head, absl_hardening = head, absl_inlined_vector = head, absl_nullability = head, absl_optional = head, absl_raw_logging_internal = head, absl_span = head, absl_strings = head, absl_strings_append_and_overwrite = head, absl_strings_resize_and_overwrite = head, absl_type_traits = head, absl_weakly_mixed_integer = head
Libs: -L${libdir}  -labsl_cord 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
