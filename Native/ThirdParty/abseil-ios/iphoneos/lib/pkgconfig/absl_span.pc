Name: absl_span
Description: Abseil span library
URL: https://abseil.io/
Version: head
Requires: absl_algorithm = head, absl_config = head, absl_core_headers = head, absl_hardening = head, absl_nullability = head, absl_throw_delegate = head, absl_type_traits = head, absl_weakly_mixed_integer = head
Libs: -L${libdir}  
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
