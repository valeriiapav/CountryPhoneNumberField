prefix=/Users/valeriiap/Projects/CountryPhoneNumberField/CountryPhoneNumberField/Native/ThirdParty/abseil-ios/iphoneos
exec_prefix=${prefix}
libdir=/Users/valeriiap/Projects/CountryPhoneNumberField/CountryPhoneNumberField/Native/ThirdParty/abseil-ios/iphoneos/lib
includedir=/Users/valeriiap/Projects/CountryPhoneNumberField/CountryPhoneNumberField/Native/ThirdParty/abseil-ios/iphoneos/include

Name: absl_crc_internal
Description: Abseil crc_internal library
URL: https://abseil.io/
Version: head
Requires: absl_crc_cpu_detect = head, absl_bits = head, absl_config = head, absl_core_headers = head, absl_endian = head, absl_memory = head, absl_prefetch = head, absl_raw_logging_internal = head
Libs: -L${libdir}  -labsl_crc_internal 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
