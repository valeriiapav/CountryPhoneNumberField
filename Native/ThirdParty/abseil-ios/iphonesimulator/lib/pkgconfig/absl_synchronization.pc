prefix=/Users/valeriiap/Projects/CountryPhoneNumberField/CountryPhoneNumberField/Native/ThirdParty/abseil-ios/iphonesimulator
exec_prefix=${prefix}
libdir=/Users/valeriiap/Projects/CountryPhoneNumberField/CountryPhoneNumberField/Native/ThirdParty/abseil-ios/iphonesimulator/lib
includedir=/Users/valeriiap/Projects/CountryPhoneNumberField/CountryPhoneNumberField/Native/ThirdParty/abseil-ios/iphonesimulator/include

Name: absl_synchronization
Description: Abseil synchronization library
URL: https://abseil.io/
Version: head
Requires: absl_graphcycles_internal = head, absl_kernel_timeout_internal = head, absl_atomic_hook = head, absl_base = head, absl_base_internal = head, absl_config = head, absl_core_headers = head, absl_dynamic_annotations = head, absl_malloc_internal = head, absl_meta = head, absl_nullability = head, absl_raw_logging_internal = head, absl_stacktrace = head, absl_symbolize = head, absl_time = head, absl_tracing_internal = head
Libs: -L${libdir}  -labsl_synchronization 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
