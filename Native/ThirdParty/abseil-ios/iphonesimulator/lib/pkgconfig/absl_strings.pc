prefix=/Users/valeriiap/Projects/CountryPhoneNumberField/CountryPhoneNumberField/Native/ThirdParty/abseil-ios/iphonesimulator
exec_prefix=${prefix}
libdir=/Users/valeriiap/Projects/CountryPhoneNumberField/CountryPhoneNumberField/Native/ThirdParty/abseil-ios/iphonesimulator/lib
includedir=/Users/valeriiap/Projects/CountryPhoneNumberField/CountryPhoneNumberField/Native/ThirdParty/abseil-ios/iphonesimulator/include

Name: absl_strings
Description: Abseil strings library
URL: https://abseil.io/
Version: head
Requires: absl_string_view = head, absl_strings_append_and_overwrite = head, absl_strings_internal = head, absl_strings_resize_and_overwrite = head, absl_base = head, absl_bits = head, absl_charset = head, absl_config = head, absl_core_headers = head, absl_endian = head, absl_hardening = head, absl_int128 = head, absl_iterator_traits_internal = head, absl_memory = head, absl_nullability = head, absl_raw_logging_internal = head, absl_source_location = head, absl_strings = head, absl_throw_delegate = head, absl_type_traits = head
Libs: -L${libdir}  -labsl_strings 
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
