Name: absl_btree
Description: Abseil btree library
URL: https://abseil.io/
Version: head
Requires: absl_common_policy_traits = head, absl_compare = head, absl_compressed_tuple = head, absl_config = head, absl_container_common = head, absl_container_memory = head, absl_cord = head, absl_core_headers = head, absl_hardening = head, absl_layout = head, absl_memory = head, absl_raw_logging_internal = head, absl_strings = head, absl_throw_delegate = head, absl_type_traits = head, absl_weakly_mixed_integer = head
Libs: -L${libdir}  
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
