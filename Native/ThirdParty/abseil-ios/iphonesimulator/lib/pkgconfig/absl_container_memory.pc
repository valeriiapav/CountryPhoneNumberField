Name: absl_container_memory
Description: Abseil container_memory library
URL: https://abseil.io/
Version: head
Requires: absl_config = head, absl_hash = head, absl_memory = head, absl_type_traits = head, absl_utility = head
Libs: -L${libdir}  
Cflags: -I${includedir} -Wno-float-conversion -Wno-implicit-float-conversion -Wno-implicit-int-float-conversion -Wno-unknown-warning-option -Wno-unused-command-line-argument -DNOMINMAX
