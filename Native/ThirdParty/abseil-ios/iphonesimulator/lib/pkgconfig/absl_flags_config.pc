Name: absl_flags_config
Description: Abseil flags_config library
URL: https://abseil.io/
Version: head
Requires: absl_config = head, absl_flags_path_util = head, absl_flags_program_name = head, absl_core_headers = head, absl_no_destructor = head, absl_strings = head, absl_synchronization = head
Libs: -L${libdir}  -labsl_flags_config 
